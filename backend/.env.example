# ╔══════════════════════════════════════════════════════════════════╗
# ║  Adaptive Security MVP — Variáveis de Ambiente                  ║
# ║  Copie este arquivo para .env e preencha os valores             ║
# ║  NÃO commite o arquivo .env com credenciais reais               ║
# ╚══════════════════════════════════════════════════════════════════╝

# ── Aplicação ──────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
DEBUG=true                       # false em produção

# ── API ────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
API_V1_PREFIX=/api/v1

# ── CORS (separado por vírgula) ────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── Banco de dados ─────────────────────────────────────────────────
# SQLite local (padrão):
DATABASE_URL=sqlite+aiosqlite:///./data/adaptive_security.db

# ── Segurança ──────────────────────────────────────────────────────
# Gere com: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=SUBSTITUA-POR-VALOR-GERADO-LOCALMENTE
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Integração com LLM (escolha um provedor) ───────────────────────
# Opções implementadas: mock | bob | watsonx
LLM_PROVIDER=mock
LLM_MODEL=mock-model
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=1024

# ── IBM Watsonx (apenas se LLM_PROVIDER=watsonx) ───────────────────
# Instale antes: pip install ibm-watsonx-ai
# LLM_API_KEY=...                # IBM Cloud API Key; valor real somente no .env local
# LLM_MODEL=ibm/granite-13b-chat-v2
# LLM_BASE_URL=https://us-south.ml.cloud.ibm.com
# WATSONX_PROJECT_ID=...         # ID do projeto no Watsonx
# WATSONX_REGION=us-south

# ── IBM Bob Shell (apenas se LLM_PROVIDER=bob) ─────────────────────
# Requer o comando `bob` instalado. A chave Inference já contém o time e
# não exige modelo. Cole o valor real somente no backend/.env local.
# BOB_API_KEY=                    # nunca coloque a chave real neste exemplo
# BOB_TEAM_ID=                    # somente para chave do tipo General
BOB_SHELL_COMMAND=bob
BOB_MAX_COST=0.05
BOB_TIMEOUT_SECONDS=90
AGENT_PIPELINE_TIMEOUT_SECONDS=195

# ── Modo dos agentes ───────────────────────────────────────────────
# auto: determinado pelo provider (mock → RULES_MODE, outros → AI_MODE)
# AI_MODE: força análise com LLM real
# RULES_MODE: força análise determinística sem LLM
AGENT_MODE=auto

# ── Motor de decisão — limiares de risco ──────────────────────────
RISK_THRESHOLD_LOW=0.3
RISK_THRESHOLD_MEDIUM=0.6
RISK_THRESHOLD_HIGH=0.85
